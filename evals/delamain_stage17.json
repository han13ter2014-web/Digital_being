              {
                "action": "write_file",
                "args": {
                  "path": "approval/fixed.txt",
                  "content": "fixed"
                }
              }
            ]
          ],
          "resolve": "approve",
          "expect": {
            "ok": true,
            "pending": true,
            "resolution": "approved",
            "approval_status": "consumed",
            "goal_status": "done",
            "files": {
              "approval/keep.txt": "keep",
              "approval/fixed.txt": "fixed"
