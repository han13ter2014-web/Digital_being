{
  "name": "delamain-stage17",
  "version": 1,
  "description": "Deterministic capability baseline for Delamain-local: execution, recovery, long horizon, approval safety, exact skill reuse and heuristic planning probes.",
  "cases": [
    {
      "id": "basic-write-verify",
      "kind": "execution",
      "category": "basic",
      "description": "A two-step write/verify plan completes and leaves the expected file.",
      "steps": [
        {
          "goal": "basic-write-verify",
          "command": "write notes/hello.txt: hello",
          "planner_plan": [
            {
              "action": "write_file",
              "args": {
                "path": "notes/hello.txt",
                "content": "hello"
              }
            },
            {
              "action": "verify_file",
              "args": {
                "path": "notes/hello.txt",
                "contains": "hello"
              }
            }
          ],
          "expect": {
            "ok": true,
            "goal_status": "done",
            "files": {
              "notes/hello.txt": "hello"
            },
            "effective_actions": [
              {
                "action": "write_file",
                "args": {
                  "path": "notes/hello.txt",
                  "content": "hello"
                }
              },
              {
                "action": "verify_file",
                "args": {
                  "path": "notes/hello.txt",
                  "contains": "hello"
                }
              }
            ],
            "effective_steps": 2,
            "history_actions": [
              "task.start",
              "write_file",
              "verify_file",
              "task.finish"
            ],
            "plan_calls": 1,
            "replan_calls": 0
          }
        }
      ]
    },
    {
      "id": "basic-search",
      "kind": "execution",
      "category": "basic",
      "description": "Search finds exactly one seeded TODO line.",
      "workspace": {
        "notes/a.txt": "alpha\nTODO beta\n",
        "notes/b.txt": "gamma\n"
      },
      "steps": [
        {
          "goal": "basic-search",
          "command": "search TODO in **/*.txt",
          "planner_plan": [
            {
              "action": "search_files",
              "args": {
                "query": "TODO",
                "pattern": "**/*.txt"
              }
            }
          ],
          "expect": {
            "ok": true,
            "goal_status": "done",
            "output_fields": {
              "query": "TODO",
              "count": 1
            },
            "effective_actions": [
              {
                "action": "search_files",
                "args": {
                  "query": "TODO",
                  "pattern": "**/*.txt"
                }
              }
            ],
            "plan_calls": 1,
            "replan_calls": 0
          }
        }
      ]
    },
    {
      "id": "basic-memory",
      "kind": "execution",
      "category": "basic",
      "description": "A fact survives remember/recall within one task.",
      "steps": [
        {
          "goal": "basic-memory",
          "command": "memory roundtrip",
          "planner_plan": [
            {
              "action": "remember_fact",
              "args": {
                "key": "project",
                "value": "Digital Being",
                "source": "eval"
              }
            },
            {
              "action": "recall_facts",
              "args": {
                "query": "project"
              }
            }
          ],
          "expect": {
            "ok": true,
            "goal_status": "done",
            "facts": [
              {
                "key": "project",
                "value": "Digital Being"
              }
            ],
            "effective_actions": [
              {
                "action": "remember_fact",
                "args": {
                  "key": "project",
                  "value": "Digital Being",
                  "source": "eval"
                }
              },
              {
                "action": "recall_facts",
                "args": {
                  "query": "project"
                }
              }
            ],
            "plan_calls": 1,
            "replan_calls": 0
          }
        }
      ]
    },
