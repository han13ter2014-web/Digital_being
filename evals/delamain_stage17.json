    {
      "id": "recovery-replace",
      "kind": "execution",
      "category": "recovery",
      "description": "A failed read is repaired by replacing the remaining plan; the discarded tail never runs.",
      "step_repair_enabled": true,
      "max_step_repairs": 1,
      "max_repair_steps": 5,
      "steps": [
        {
          "goal": "recovery-replace",
          "command": "recovery replace",
          "plan": [
            {
              "action": "write_file",
              "args": {
                "path": "recovery/keep.txt",
                "content": "keep"
              }
            },
            {
              "action": "read_file",
              "args": {
                "path": "recovery/missing.txt"
              }
            },
            {
              "action": "write_file",
              "args": {
                "path": "recovery/tail.txt",
                "content": "tail"
              }
            }
          ],
          "repair_plans": [
            [
              {
                "action": "write_file",
                "args": {
                  "path": "recovery/fixed.txt",
                  "content": "fixed"
                }
              }
            ]
          ],
          "expect": {
            "ok": true,
            "pending": false,
            "goal_status": "done",
            "files": {
              "recovery/keep.txt": "keep",
              "recovery/fixed.txt": "fixed"
            },
            "absent_files": [
              "recovery/tail.txt"
            ],
            "effective_actions": [
              {
                "action": "write_file",
                "args": {
                  "path": "recovery/keep.txt",
                  "content": "keep"
                }
              },
              {
                "action": "write_file",
                "args": {
                  "path": "recovery/fixed.txt",
                  "content": "fixed"
                }
              }
            ],
            "planned_actions": [
              {
                "action": "write_file",
                "args": {
                  "path": "recovery/keep.txt",
                  "content": "keep"
                }
              },
              {
                "action": "read_file",
                "args": {
                  "path": "recovery/missing.txt"
                }
              },
              {
                "action": "write_file",
                "args": {
                  "path": "recovery/fixed.txt",
                  "content": "fixed"
                }
              }
            ],
            "repair_count": 1,
            "min_steps": 3,
            "effective_steps": 2,
            "history_actions": [
              "task.start",
              "write_file",
              "read_file",
              "task.repair",
              "write_file",
              "task.finish"
            ],
            "plan_calls": 0,
            "replan_calls": 1
          }
        }
      ]
    },
    {
      "id": "recovery-approval",
      "kind": "execution",
      "category": "recovery",
      "description": "A dangerous repair waits for approval and resumes with completed steps preserved.",
      "step_repair_enabled": true,
      "max_step_repairs": 1,
      "max_repair_steps": 5,
      "approval_mode": "dangerous",
      "workspace": {
        "approval/keep.txt": "keep"
